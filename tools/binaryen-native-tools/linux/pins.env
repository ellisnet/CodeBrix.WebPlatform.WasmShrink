# ==============================================================================================
# pins.env - EVERY version / digest / option pin used by tools/binaryen-native-tools.
# Edit here only. build.sh and container-build.sh both source this file and echo the resolved
# values at the top of every run, so a build log always says exactly what it used. The Windows
# and macOS scripts read its platform-neutral keys (BINARYEN_*, EXE_NAME, LICENCE_FILES,
# CONSUMER_*) too, so every platform builds and gates the same thing.
# ==============================================================================================

# --- Container images -------------------------------------------------------------------------
# The manylinux images exist to fix the glibc baseline. Building on a modern desktop distro
# bakes THAT distro's glibc version into the executable, and glibc symbol versioning is
# forward-only, so wasm-opt would then refuse to start on anything older - a failure that only
# shows up on a user's machine.
#
#   image                                  glibc  runs on
#   manylinux_2_28_x86_64                  2.28   Debian 10+, Ubuntu 20.04+, RHEL 8+
#   manylinux_2_28_aarch64                 2.28   every 64-bit Raspberry Pi OS, Ubuntu 20.04+
#
# These are the same two images, at the same dated tag and the same digests, that
# CodeBrix.LibGit2 (and CodeBrix.Sdl3, CodeBrix.VideoPlayback.Dav1d, CodeBrix.Ollama,
# CodeBrix.Audio) pin, so every CodeBrix Linux native comes from one base userland. The digest
# is what the build actually pins: the dated tag is there so a human can see which image
# generation it is, but build.sh resolves the digest, so an upstream retag cannot silently
# change the toolchain under a rebuild.
IMAGE_X64=quay.io/pypa/manylinux_2_28_x86_64:2026.07.19-1
IMAGE_X64_DIGEST=sha256:a61875a2f84cab7df8de222ff12cabc08ff86eb4ad402ac90ba7bdaed9600cca
IMAGE_ARM64=quay.io/pypa/manylinux_2_28_aarch64:2026.07.19-1
IMAGE_ARM64_DIGEST=sha256:162c81dfd3efc710732a571717d3c916a6945ebf279e879ddee3243af96fe46f

# The derived images this tooling builds ON TOP of those (base + cmake + ninja + `file`).
# Building one is the documented "install the tools on the build machine" step and is the ONLY
# step that uses the network; the actual build then runs with --network none.
DERIVED_IMAGE_PREFIX=codebrix-binaryen-build

# --- Build tools installed into the derived images ---------------------------------------------
# cmake and ninja as PyPI wheels, pinned exactly - the same pins as CodeBrix.LibGit2's
# libgit2-native-tools. They are installed from the manylinux image's own CPython
# (PYTHON_IN_IMAGE). binaryen 133 needs cmake >= 3.16.3 (its cmake_minimum_required).
CMAKE_VERSION=4.4.3
NINJA_VERSION=1.13.2
PYTHON_IN_IMAGE=/opt/python/cp313-cp313/bin/python

# binaryen 133 is C++20 (CMAKE_CXX_STANDARD 20, CMAKE_CXX_STANDARD_REQUIRED ON). The images'
# compiler is gcc-toolset-14 (GCC 14.2.1); the gate refuses anything older than this major.
MIN_GCC_MAJOR=11

# NO -devel PACKAGES ARE INSTALLED, ON PURPOSE. wasm-opt needs nothing but a C++20 compiler and
# its own source: the bundled pieces (LLVM's DWARF code, FP16) are in ../binaryen/third_party,
# and the static libstdc++ / libgcc archives come with the image's gcc-toolset-14
# (/opt/rh/gcc-toolset-14/root/usr/lib/gcc/<triple>/14/libstdc++.a, libgcc_eh.a).

# --- Vendored source (in-repo; nothing is fetched at build time) --------------------------------
BINARYEN_DIR=binaryen
BINARYEN_VERSION=133
BINARYEN_TAG=version_133
BINARYEN_COMMIT=fba5005a132d85d578be5bd010e0487ed8e2ce3e
BINARYEN_TARBALL_SHA256=2f3e3d9edc56751499571da073a8a81943ca3fcbc08a945d2c619a7a1d4eb88b

# --- The shipped file -------------------------------------------------------------------------
# One executable per RID: wasm-opt (wasm-opt.exe on Windows), stripped. No unstripped twin is
# kept: the build does not pass -g, so there is no debug information to keep.
EXE_NAME=wasm-opt

# The licence files copied beside the executable, as "<shipped name>:<path under the tools
# folder>". Each is a verbatim copy of an upstream file (or, for LICENSE-Unicode.txt, of an
# upstream file header - see ../LICENSE-Unicode.txt). Exactly the pieces COMPILED INTO wasm-opt
# get one; the evidence for each is written to output/<rid>/third-party-evidence.txt on every
# Linux build (README.txt, WHAT IS COMPILED IN). Never a file named plainly LICENSE: these land
# in a consuming application's output folder, where that name collides.
LICENCE_FILES="LICENSE-Binaryen.txt:binaryen/LICENSE
LICENSE-Llvm.txt:binaryen/third_party/llvm-project/include/llvm/LICENSE.TXT
LICENSE-LlvmSupport.txt:binaryen/third_party/llvm-project/include/llvm/Support/LICENSE.TXT
LICENSE-Unicode.txt:LICENSE-Unicode.txt
LICENSE-Fp16.txt:binaryen/third_party/FP16/LICENSE"

# --- binaryen CMake options ---------------------------------------------------------------------
# UPSTREAM'S RELEASE RECIPE (.github/workflows/create_release.yml in the release archive) is
#   cmake -G Ninja -DCMAKE_BUILD_TYPE=Release ... ; cmake --build --target install; strip
# for macOS / Windows, and, for Linux, a FULLY STATIC musl build in Alpine:
#   -DCMAKE_CXX_FLAGS=-static -DCMAKE_C_FLAGS=-static
#   -DCMAKE_EXE_LINKER_FLAGS=-Wl,-z,stack-size=8388608 -DBUILD_SHARED_LIBS=OFF
#   -DBUILD_MIMALLOC=ON
# with every other option at its default (BUILD_TESTS ON, ENABLE_WERROR ON, BUILD_LLVM_DWARF ON,
# BYN_ENABLE_ASSERTIONS ON). How and why this build differs is in ../BUILD-PROVENANCE.txt
# (DIFFERENCES FROM UPSTREAM'S RELEASE BUILD). In short, each option below, with its reason:
#
#   -DCMAKE_BUILD_TYPE=Release     upstream's; CMake's -O3 -DNDEBUG, and binaryen itself adds
#                                  -UNDEBUG because assertions stay ON (upstream default)
#   -DBUILD_SHARED_LIBS=OFF        libbinaryen as a STATIC library linked into wasm-opt (upstream's
#                                  Linux release does the same; the Unix default is ON = a
#                                  libbinaryen.so beside the tool). binaryen 133 has no
#                                  BUILD_STATIC_LIB option - BUILD_SHARED_LIBS is its switch.
#   -DBUILD_TESTS=OFF              no gtest (a git submodule, absent from the vendored tree)
#   -DENABLE_WERROR=OFF            a newer or older compiler's new warning must not fail a
#                                  release build; warnings are counted and recorded instead
#   -DBUILD_MIMALLOC=OFF           the default, stated: mimalloc is a git submodule, absent from
#                                  the vendored tree. glibc's allocator is used
#   -DBUILD_LLVM_DWARF=ON          the default, stated: full DWARF support (--debuginfo with
#                                  DWARF input, -g passes) from third_party/llvm-project
#   -DBYN_ENABLE_ASSERTIONS=ON     the default, stated (upstream ships assertions enabled)
#   -DCMAKE_SKIP_RPATH=ON          binaryen gives every tool INSTALL_RPATH $ORIGIN/../lib for a
#                                  shared libbinaryen; with the static library that RUNPATH would
#                                  point at nothing, so CMake is told to write none
#
# Set by container-build.sh, not here: -G Ninja, the -ffile-prefix-map compile flags, and the
# link flags -static-libstdc++ -static-libgcc -Wl,--build-id=sha1 -Wl,-z,stack-size=8388608
# -Wl,-Map=... (the map file is build evidence only, never shipped).
BINARYEN_CMAKE_OPTIONS="-DCMAKE_BUILD_TYPE=Release -DBUILD_SHARED_LIBS=OFF -DBUILD_TESTS=OFF -DENABLE_WERROR=OFF -DBUILD_MIMALLOC=OFF -DBUILD_LLVM_DWARF=ON -DBYN_ENABLE_ASSERTIONS=ON -DCMAKE_SKIP_RPATH=ON"

# The one CMake target built. Only wasm-opt (and the static libraries it links) is compiled.
BUILD_TARGET=wasm-opt

# Lines binaryen's configure step MUST print. A configure log without one fails the gate: it
# means an option did not take (a shared library, mimalloc, no DWARF) - a decision, not an
# accident. One fixed string per line.
REQUIRED_CONFIGURE_LINES="Building libbinaryen as statically linked library.
Building with -DBUILD_LLVM_DWARF
Building with -UNDEBUG"
# ...and lines it must NOT print.
FORBIDDEN_CONFIGURE_LINES="Building libbinaryen as shared library.
Building with mimalloc allocator.
Building with -Werror"

# --- Verification gate ---------------------------------------------------------------------------
# The highest GLIBC_x.y symbol version the shipped executable may reference. This IS the oldest
# system it can start on, so it is checked, not merely reported.
GLIBC_MAX_X64=2.28
GLIBC_MAX_ARM64=2.28

# Shared libraries the executable may depend on: glibc and its loader, nothing else. libstdc++
# and libgcc_s are linked STATICALLY (-static-libstdc++ -static-libgcc) and are named
# explicitly, so the gate says so if either ever comes back.
ALLOWED_DEPS="libc.so.6 libm.so.6 libpthread.so.0 libdl.so.2 librt.so.1 ld-linux-x86-64.so.2 ld-linux-aarch64.so.1"
FORBIDDEN_DEP_PATTERN='^(libstdc\+\+|libgcc_s|libbinaryen|libmimalloc|libatomic)'

# The exact flag sets the consuming .NET tool passes to wasm-opt. The gate runs every one of
# them against linux/gate-fixture.wat, on every platform. CONSUMER_FEATURES is also given to the
# plain -O0 / -Oz runs, because the fixture uses those features.
CONSUMER_FEATURES="--enable-reference-types --enable-bulk-memory --enable-mutable-globals --enable-nontrapping-float-to-int --enable-threads"
CONSUMER_RELEASE_FLAGS="--strip-debug -Oz"
CONSUMER_DEBUG_FLAGS="--debuginfo -Oz"
CONSUMER_PACKING_FLAGS="--strip-debug --memory-packing -Oz"

# What --fuzz-exec must report for the fixture's exports, before AND after optimisation (the
# interpreter inside wasm-opt runs each export; a wrong optimisation changes a result). One
# "export => value" per line, matched as "[fuzz-exec] note result: <line>".
EXPECTED_RESULTS="factorial_of_10 => 3628800
table_sum => 70
saturating_convert => 2147483647
bump_counter => 5
fill_and_copy => 50529027
atomic_add => 9
data_byte => 67
ref_is_null => 0"
