<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>CodeBrix.WebPlatform.WasmShrink</AssemblyName>
    <RootNamespace>CodeBrix.WebPlatform.WasmShrink</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!--
    Package / assembly version: date-stamped and auto-incrementing.

    Format:  1.<x>.<y>.<z>   (every field is derived from UTC "now")

      1  (major)     Always 1 for this library.
      x  (minor)     Whole years since $(_VersionBaseYear).
                     With base 2026: 2026=0, 2027=1, 2028=2, ...
      y  (build)     Day of year, 1-based inclusive, UTC.
                     Jan 1 = 1, Feb 1 = 32, Dec 31 = 365 (366 in a leap year).
      z  (revision)  Minute of day, UTC, range 0 to 1439.
                     00:00 = 0, 23:59 = 1439.

    The version is always strictly increasing over time:
      * within a day, z grows;
      * at a day boundary, y increments and outranks z resetting to 0;
      * at a (UTC) year boundary, x increments and outranks y and z resetting.

    Notes / caveats:
      * All fields read from System.DateTime.UtcNow, so a local dev build and a
        UTC CI build agree on the value. Math.Floor on the minutes keeps z in
        0..1439 (plain rounding could land on 1440 late in the day).
      * Because the value depends on the clock, every build produces a NEW
        version. With GeneratePackageOnBuild=true that means a fresh .nupkg on
        each build, and two builds in the SAME UTC minute produce the SAME
        version (so do not publish two packages from within one minute).
      * This is date-stamp versioning, not SemVer: minor encodes the year and
        major is pinned to 1, so major/minor do not signal API compatibility.
      * To re-baseline the minor number, change _VersionBaseYear below.
  -->
  <PropertyGroup>
    <_VersionBaseYear>2026</_VersionBaseYear>
    <_VersionYears>$([MSBuild]::Subtract($([System.DateTime]::UtcNow.Year), $(_VersionBaseYear)))</_VersionYears>
    <_VersionDayOfYear>$([System.DateTime]::UtcNow.DayOfYear)</_VersionDayOfYear>
    <_VersionMinuteOfDay>$([System.Convert]::ToInt32($([System.Math]::Floor($([System.DateTime]::UtcNow.TimeOfDay.TotalMinutes)))))</_VersionMinuteOfDay>
    <BuildVersion>1.$(_VersionYears).$(_VersionDayOfYear).$(_VersionMinuteOfDay)</BuildVersion>
    <Version>$(BuildVersion)</Version>
    <AssemblyVersion>$(BuildVersion)</AssemblyVersion>
    <FileVersion>$(BuildVersion)</FileVersion>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>CodeBrix.WebPlatform.WasmShrink.ApacheLicenseForever</PackageId>
    <Product>CodeBrix.WebPlatform.WasmShrink</Product>
    <Title>CodeBrix.WebPlatform.WasmShrink</Title>
    <Authors>Jeremy Ellis</Authors>
    <Description>The WebAssembly size optimizer for the CodeBrix.WebPlatform web application platform: the wasm-opt program for each supported build platform, and a small .NET library that finds the copy for the current machine, makes it runnable, and runs it. Referencing the package is all a build needs to shrink the WebAssembly it produces - nothing has to be installed.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ellisnet/CodeBrix.WebPlatform.WasmShrink</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ellisnet/CodeBrix.WebPlatform.WasmShrink</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageIcon>icon-codebrix-128.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Copyright>Copyright (c) 2026 Jeremy Ellis and contributors</Copyright>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <IsPackable>true</IsPackable>
    <PackageTags>webassembly;wasm;wasm-opt;optimizer;size;build;tools;CodeBrix</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\icon-codebrix-128.png" Pack="true" PackagePath="" />
    <None Include="..\..\README.md" Pack="true" PackagePath="" />
    <None Include="..\..\AGENT-README.txt" Pack="true" PackagePath="" />
    <None Include="..\..\THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="" />
  </ItemGroup>

  <!--
    The wasm-opt programs, committed under native_libraries/<rid>/ and built by the scripts in
    tools/binaryen-native-tools (see MAINTAINER-README.txt). Each <rid> folder holds the program
    and the licence texts of what is compiled into it; the *.provenance.txt build records beside
    them stay in the repository and are not shipped.

    They are NOT packed under runtimes/<rid>/native. That convention is for libraries a process
    loads, and it flattens or mixes files from every package into one folder. A program that is
    put on PATH needs a folder of its own, at the same place whatever the consumer's RuntimeIdentifier
    is. So:

      * in the package they sit under tools/wasm-opt/<rid>/, and
        buildTransitive/CodeBrix.WebPlatform.WasmShrink.ApacheLicenseForever.targets copies that
        tree into the consuming project's output folder as wasm-opt/<rid>/;
      * for a project reference (the tests), the items below do the same copy directly.

    WasmShrinkTool looks for <application folder>/wasm-opt/<rid>/wasm-opt[.exe].

    A platform whose binary has not been built yet simply has no folder; the package still packs,
    and WasmShrinkTool reports that platform as not included.
  -->
  <ItemGroup>
    <None Include="..\..\native_libraries\**\*" Exclude="..\..\native_libraries\**\*.provenance.txt"
          Pack="true" PackagePath="tools\wasm-opt"
          Link="wasm-opt\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="buildTransitive\CodeBrix.WebPlatform.WasmShrink.ApacheLicenseForever.targets"
          Pack="true" PackagePath="buildTransitive" />
  </ItemGroup>

</Project>
